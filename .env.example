# Copy to `.env` before `docker compose up --build`.
# Never commit the real `.env`.

# Admin seed (required, 12+ characters)
SEED_ADMIN_EMAIL=admin@karam-alarab.com
SEED_ADMIN_PASSWORD=

# Operations seed (optional; created on API boot when password is 12+)
SEED_OPS_EMAIL=ops@karam-alarab.com
SEED_OPS_PASSWORD=

# Where staff open the UI in the browser (scheme + host + port).
# Must match the URL you type (CORS + cookie).
WEB_ORIGIN=http://127.0.0.1:8080
WEB_PORT=8080

# development = HttpOnly cookie without Secure (HTTP ok).
# production  = Secure cookies — use only behind HTTPS.
ENVIRONMENT=development

POSTGRES_PASSWORD=karam
SESSION_COOKIE_NAME=karam_session
SESSION_TTL_SECONDS=28800
